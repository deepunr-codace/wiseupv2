---
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  mainClass?: string;
  mood?: 'day';
  /** Theme this page should open in before the visitor has ever toggled (localStorage empty).
   *  Once they've toggled once (on any page), their choice persists everywhere as normal.
   *  Defaults to 'dark' (the site's default theme as of 2026-10-24); pass 'light' on a page that must open light. */
  defaultTheme?: 'light' | 'dark';
}
const { title, description = site.description, image = '/og.png', mainClass, mood, defaultTheme = 'dark' } = Astro.props;
const fullTitle = title ?? `Branding & Marketing Agency in Kerala (Kozhikode) | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kozhikode',
    addressRegion: 'Kerala',
    addressCountry: 'IN',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 11.2588, longitude: 75.7804 },
  parentOrganization: { '@type': 'Organization', name: 'CodeAce', url: 'https://codeace.com' },
  sameAs: site.socials.map((s) => s.href),
};
import LeadModal from '../components/LeadModal.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#050506" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/inter-300_700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-200_500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline define:vars={{ defaultTheme }}>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      // Applied before paint so there's no flash of the wrong theme. themeToggle() in
      // motion/main.ts owns the click handler and keeps this in sync after first load.
      // `defaultTheme` only covers a visitor who has never toggled anywhere (no stored key) —
      // an explicit past choice (light OR dark) always wins once one exists.
      try {
        const stored = localStorage.getItem('wu-theme');
        const theme = stored ?? defaultTheme;
        if (theme === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main" tabindex="-1" class={mainClass} data-mood={mood}>
      <slot />
    </main>
    <slot name="footer" />
    <LeadModal />
    <script>
      import { boot } from '../engine';
      import { setupMotion } from "../motion/main";
      boot(setupMotion);
    </script>
  </body>
</html>
