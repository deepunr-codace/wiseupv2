---
import { site } from '../data/site';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
// User-supplied 2026-10-23 (D:\projects\wiseup\reference\logo.png, "logo for white bg") — a
// cleaner single-line "Wise Up" brush-script mark, no "Branding" subtitle, replacing the previous
// two-line lockup. Same white-on-transparent asset type as before, so the existing light/dark
// invert mechanism (:root[data-theme='light'] .hd__logo img { filter: invert(1) }, and
// .hd__logo--dark for /about) needs no changes — it already handles any white-glyph logo.
import logo from '../assets/brand/logo.png';
// `current` marks a whole page as current (e.g. 'contact' on /contact) for the logo-invert logic
// below; `cta` is where the header button points. The nav itself (site.nav) is now the real
// wiseup.in menu — external links to other WiseUp properties, not in-page anchors on this site —
// so there's no scroll-spy/current-link highlighting to do for it any more (none of these hrefs
// correspond to a section on this page, so header()'s ScrollTrigger-per-link setup in
// motion/main.ts already no-ops safely for all of them: it only acts when
// document.getElementById(id) finds a matching on-page section).
interface Props { current?: string; cta?: string }
const { current, cta = '/#contact' } = Astro.props;
const links = site.nav;
// The logo scrolls back to #top on the home page; on every other page (no #top there) it goes home.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
---
<header class="hd" data-head>
  <a class:list={['hd__logo', { 'hd__logo--dark': current === 'about' }]} href={isHome ? '#top' : '/'} aria-label={isHome ? 'WiseUp, back to top' : 'WiseUp home'}>
    <Image src={logo} alt="WiseUp" width={315} height={114} />
  </a>

  <nav class="hd__nav" aria-label="WiseUp sites">
    {links.map((l) => (
      <a class="hd__link" href={l.href} target="_blank" rel="noopener"><span class="hd__dot" aria-hidden="true"></span>{l.label}</a>
    ))}
  </nav>

  <div class="hd__actions">
    <button class="hd__theme" type="button" data-theme-toggle aria-label="Switch to light mode" aria-pressed="false">
      <span class="hd__theme-ico">
        <Icon name="moon" size={18} class="ico--moon" />
        <Icon name="sun" size={18} class="ico--sun" />
      </span>
    </button>

    <a class="hd__cta" href={cta}>
      <span class="hd__cta-glow" aria-hidden="true"></span>
      <span class="hd__cta-border" aria-hidden="true"></span>
      <span class="hd__cta-shine" aria-hidden="true"></span>
      <span class="hd__cta-inner"><span class="hd__cta-label">{site.ctaShort}</span></span>
    </a>

    <button class="hd__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <Icon name="menu" size={18} /><span>Menu</span>
    </button>
  </div>
  <div class="menu" id="menu" hidden data-menu>
    {links.map((l) => <a href={l.href} target="_blank" rel="noopener" data-menu-link><span class="hd__dot" aria-hidden="true"></span>{l.label}</a>)}
    <Button href={cta} label={site.ctaShort} look="teal" block data-menu-link />
  </div>
</header>
