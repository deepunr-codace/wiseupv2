---
// Site footer (every page): tagline, three link columns (social links under Follow Us), then the "Wiseup" wordmark:
// interactive particles on a canvas (motion/footer-wordmark.ts), sized by an invisible copy of the word. On /podcast it adds the channel card with a subscribe button and swaps the agency's social links for the
// podcast's own (site.podcastSocials).
import { site } from '../data/site';

const isPodcast = Astro.url.pathname.startsWith('/podcast');
const year = new Date().getFullYear();
const CHANNEL = 'https://www.youtube.com/@WiseUpPodcast_';
const nav = (label: string) => site.nav.find((n) => n.label === label)?.href ?? '#';
const quick = ['WiseUp TV', 'WiseUp Studio', 'WiseUp Podcast'].map((label) => ({ label, href: nav(label) }));
const useful = [
  { label: 'Be a Guest', href: '/podcast/#guest' },
  { label: 'Portfolio', href: nav('Portfolio') },
  { label: 'Case Studies', href: nav('Case Studies') },
];
// Original brand logos in their own colours. Glyph paths from Simple Icons (CC0, simple-icons@13.21.0); the Gmail
// "M" is Google's 2020 logo (Wikimedia Commons). Two-tone marks get their white parts back underneath: LinkedIn's "in",
// YouTube's play triangle. Instagram gets its gradient.
const ytPath = 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z';
