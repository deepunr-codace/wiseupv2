const links = isPodcast
  ? site.podcastSocials
  : [{ label: 'WhatsApp', href: site.whatsapp }, ...site.socials, { label: 'Email', href: `mailto:${site.email}` }];
const social = links.filter((s) => brand[s.label]).map((s) => ({ ...s, ...brand[s.label] }));
const follow = isPodcast
  ? 'Fresh conversations every week. Follow along.'
  : 'Follow WiseUp for brand stories, campaign launches and a look inside the studio.';
const ytLogo = '<svg viewBox="0 0 68 48" aria-hidden="true"><path fill="#f00" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path fill="#fff" d="M45 24 27 14v20z"/></svg>';
---
<footer class="ft">
  <div class="wrap ft__top">
    <div class="ft__intro">
      <p class="ft__tag">Your gateway to inspiration and growth. Where ideas ignite and dreams take flight!</p>
      {isPodcast && (
        <div class="ft__yt">
          <span class="ft__yt-ava" set:html={ytLogo} />
          <span class="ft__yt-meta">
            <b>WiseUp Podcast</b>
            <span>@WiseUpPodcast_</span>
          </span>
          <a class="ft__yt-sub" href={`${CHANNEL}?sub_confirmation=1`} target="_blank" rel="noopener">
            <svg class="ft__yt-glyph" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={ytPath} /></svg>Subscribe
          </a>
        </div>
      )}
    </div>
    <nav class="ft__col" aria-labelledby="ft-quick">
      <h2 class="ft__h" id="ft-quick">Quick Links</h2>
      <ul>{quick.map((l) => <li><a class="ft__link" href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}</ul>
    </nav>
    <nav class="ft__col" aria-labelledby="ft-useful">
      <h2 class="ft__h" id="ft-useful">Useful Links</h2>
      <ul>{useful.map((l) => <li><a class="ft__link" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a></li>)}</ul>
    </nav>
    <div class="ft__col ft__follow">
      <h2 class="ft__h">Follow Us</h2>
      <p>{follow}</p>
      <ul class="ft__social">
        {social.map((s) => (
          <li>
            <a class={`ft__soc ft__soc--${s.mod}`} href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel="me noopener" aria-label={s.label}>
              <Fragment set:html={s.svg} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="ft__word" aria-hidden="true" data-ft-word>
    <span class="ft__word-text">wiseup</span>
    <canvas class="ft__canvas"></canvas>
  </div>
  <div class="ft__ground" data-ft-ground>
    <canvas class="ft__canvas" aria-hidden="true"></canvas>
    <div class="wrap ft__base">
      <p>© {year} WiseUp</p>
      <p>Crafted by <b class="ft__credit">Axilume</b></p>
    </div>
  </div>
</footer>
