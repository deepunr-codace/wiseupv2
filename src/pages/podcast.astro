---
// WiseUp Podcast, rebuilt on the homepage's own design system (2026-10-23), per direct owner
// instruction: "use our homepage design system to rebuild the podcast page... same as homepage
// (default light version)". Supersedes the standalone warm-paper/gold page this was before —
// now Base + Header + Footer, tokens.css's teal/lime accent and Epilogue/Inter type, and the
// shared site.css vocabulary (.wrap/.sec/.sh/.b/.card/.faq/.hgal/.loop/.cta-row), forced to the
// light ("day") mood throughout via `data-mood="day"` on the page's own wrapper, same technique
// about.astro uses. Motion: episodes are a static bento grid (lime hover); the three hosts sit in a fixed row; the shared
// engine's own loopedPanels() (motion/main.ts) via the same data attributes
// the homepage uses — not reimplemented. Only the click-to-embed thumbnail behaviour is page-
// specific (motion/podcast.ts, registered into the shared setupMotion()).
//
// Content carried over unchanged from the prior standalone build: all real video IDs (oembed-
// confirmed), real host/guest photos, the real "91K+"/"100+" stats, all 15 FAQ entries, the real
// community banner and guest-CTA banner images. See CLAUDE.md for the full sourcing history
// (which topic-card photos are real vs. placeholder stock, the Deepu/guest-photo gaps, etc.).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SecHead from '../components/SecHead.astro';
import { site } from '../data/site';
import podcastCss from '../styles/podcast.css?raw';
// Latest episodes: pulled from the channel's long-form feed by scripts/fetch-episodes.py (rerun to refresh).
import latest from '../data/episodes.json';

const CHANNEL = 'https://www.youtube.com/@WiseUpPodcast_';
// YouTube's play button (red rounded rect + white triangle), shown over every video thumbnail
const ytPlay = '<svg viewBox="0 0 68 48" aria-hidden="true"><path class="yt__bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path fill="#fff" d="M45 24 27 14v20z"/></svg>';

const featured = {
  videoId: 'h9kHyyUruSg',
  img: '/podcast/yt-featured.webp',
  guest: 'Jijo Sunny',
  guestRole: 'Co-founder & CEO, Buy Me a Coffee',
  title: 'Lakhs Flow Through Coffee, But It Is Not a Coffee Shop',
  titleMl: 'കാപ്പി വഴി ലക്ഷങ്ങൾ, പക്ഷെ കാപ്പിക്കടയല്ല',
  sub: 'A ₹400 crore Malayali startup, built around the idea of "buy me a coffee." Jijo Sunny on turning a small tip jar into a global platform.',
};
// Featured stack: two cards; the second slides up over the first on scroll (featuredStack() in motion/podcast.ts).
const featuredList = [
  { ...featured, tag: 'Featured episode' },
  {
    videoId: 'CrUDF-dJHXI', img: '/podcast/yt-litmus7.webp', tag: 'Also featured',
    guest: 'Venu Gopalakrishnan', guestRole: 'CEO, Litmus7',
    title: 'How Litmus7 CEO Shapes the Future of Retail & Tech', titleMl: '',
    sub: 'Venu Gopalakrishnan on where retail and technology are heading, and what it takes to build a company that serves both.',
  },
];


// Cover photos: real CC-licensed photography (Wikimedia Commons), standing in for brand
// photography WiseUp hasn't supplied yet for these 5 categories — see CLAUDE.md.
const topics = [
  { n: '01', label: 'Business & Entrepreneurship', desc: 'Founders on building, funding and scaling.', icon: 'target', img: '/podcast/topic-business.webp' },
  { n: '02', label: 'Marketing & Branding', desc: 'How brands win attention and trust.', icon: 'megaphone', img: '/podcast/topic-marketing.webp' },
  { n: '03', label: 'Technology & AI', desc: 'The tools changing how business works.', icon: 'code', img: '/podcast/topic-tech.webp' },
  { n: '04', label: 'Leadership & Career', desc: 'Lessons on leading people and growing.', icon: 'sprout', img: '/podcast/topic-leadership.webp' },
  { n: '05', label: 'Creators & Media', desc: 'Building an audience and a business on it.', icon: 'video', img: '/podcast/topic-creators.webp' },
];

const hosts = [
  { name: 'Jijin Mohan', role: 'Host', img: '/podcast/host-jijin.webp' },
  { name: 'Chethana', role: 'Host', img: '/podcast/host-chethana.webp' },
  { name: 'Sreerag', role: 'Host', img: '/podcast/host-sreerag.webp' },
];

// Gallery: real WiseUp Podcast shoot photos (public/podcast/gallery/gN.webp + -sm). Add one per line:
// { n: <file number>, w, h, cap, span } (span: 'big' 2x2, 'wide' 2x1, or none for 1x1). Captions stay generic:
// guests aren't named here unless confirmed.
const gallery = [
  { n: 1, w: 1600, h: 1068, cap: 'In the studio', span: 'big' },
  { n: 5, w: 1600, h: 900, cap: 'On set' },
  { n: 2, w: 1600, h: 900, cap: 'Studio session' },
  { n: 7, w: 1600, h: 1067, cap: 'Behind the microphone' },
  { n: 4, w: 1600, h: 1146, cap: 'Studio day' },
  { n: 3, w: 1600, h: 1067, cap: 'After the recording', span: 'wide' },
  { n: 6, w: 1600, h: 1067, cap: 'On location', span: 'wide' },
  { n: 8, w: 1600, h: 1132, cap: 'Book launch conversation', span: 'wide' },
  { n: 9, w: 1600, h: 1091, cap: 'With our guest', span: 'wide' },
].map((g) => ({ ...g, img: `/podcast/gallery/g${g.n}.webp`, sm: `/podcast/gallery/g${g.n}-sm.webp`, alt: `WiseUp Podcast team with a guest: ${g.cap.toLowerCase()}` }));

// Video testimonials: the 9:16 testimonial videos from wiseup.in, linked directly (poster + mp4 on the live site's
// media library, nothing copied into this repo). Add one: { poster: '<base name in 2026/06>', video: '<mp4 URL>' }.
const WP = 'https://wiseup.in/wp-content/uploads/2026';
const testimonials = [
  { poster: 'afsal', video: `${WP}/07/afsal-1.mp4` },
  { poster: 'bheegaran', video: `${WP}/07/Bheegaran-Testimonial-1.mp4` },
  { poster: 'Chef-vinod', video: `${WP}/07/Chef-Testimonial-1.mp4` },
  { poster: 'JONAH', video: `${WP}/07/Brightside-Testimonial-1.mp4` },
  { poster: 'kasinath', video: `${WP}/07/Aswathy-Achu-Testimonial-1-1.mp4` },
  { poster: 'SAJEEV-NAIR', video: `${WP}/07/Sajeev-Nair-Testimoni-compressed.mp4` },
  { poster: 'tr-shamsudheen', video: `${WP}/07/TR-Shamsudheen-Testimonial-1-compressed.mp4` },
  { poster: 'wac-1', video: `${WP}/07/compressed-video.mp4` },
];

const faqs = [
  { q: 'What is WiseUp Podcast?', a: "It's a business and entrepreneurship podcast featuring founders, business leaders, marketers, investors and industry experts." },
  { q: 'Who can be a guest on the podcast?', a: 'Founders, CEOs, business owners, industry experts, investors, creators and professionals with valuable insights or stories to share.' },
  { q: 'How can I apply to be a guest?', a: 'Submit your details through the inquiry form or contact the team directly. Guests are selected based on relevance and audience value.' },
  { q: 'Is there a fee to appear on the podcast?', a: 'Participation may be free or part of a promotional collaboration. The team can share the details.' },
  { q: 'How long is a typical podcast episode?', a: 'Most episodes run between 30 and 90 minutes.' },
  { q: 'Where are the episodes published?', a: 'On YouTube, Spotify, Instagram, Facebook and other WiseUp platforms.' },
  { q: 'Can brands sponsor an episode?', a: 'Yes. Brands can sponsor a single episode or take a monthly partnership package.' },
  { q: 'What sponsorship opportunities are available?', a: 'Episode sponsorship, product placement, host mentions, thumbnail branding, intro/outro branding, reels and shorts branding, social media promotions and long-term partnerships.' },
  { q: 'What audience does the podcast reach?', a: 'Entrepreneurs, startup founders, business owners, professionals, marketers, students and aspiring leaders.' },
  { q: 'Will I receive the podcast recording?', a: 'Yes. Guests receive the published episode link and selected promotional assets.' },
  { q: 'Can you record podcasts at our office or location?', a: 'Yes. Both studio and on-location recordings are offered.' },
  { q: 'How far in advance should I book?', a: 'Book at least 2 to 4 weeks ahead.' },
  { q: 'Do you provide podcast production services?', a: 'Yes, including recording, multi-camera setup, thumbnails, reels and shorts, publishing support and podcast marketing.' },
  { q: 'How do I become a sponsor?', a: 'Contact the team with your brand details and campaign goals to get a recommended package.' },
  { q: 'How can I contact the WiseUp Podcast team?', a: 'By phone, email (wiseuppod@gmail.com), WhatsApp (+91 6282 434 503) or the website contact form. The team responds within 24 to 48 hours.' },
];

const views = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}K` : String(n)) + ' views';
const ago = (d: string) => new Date(d).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' });
const title = 'WiseUp Podcast | The Malayalam Podcast for Online Business Owners';
const description = 'A Malayalam business podcast with entrepreneurs, creators and changemakers who are building a better tomorrow.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'PodcastSeries', name: 'WiseUp Podcast', description,
  url: 'https://wiseup.in/podcast', image: 'https://wiseup.in/podcast/banner.jpg', inLanguage: 'ml', sameAs: [CHANNEL],
};
---
<Base title={title} description={description} image="/podcast/banner.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <!-- Non-blocking: the Malayalam font swaps in once loaded (FOUC-safe, Inter already covers
       Latin text in the interim) rather than holding up first paint — a render-blocking
       <link rel="stylesheet"> here measurably delayed the hero text's paint on throttled mobile. -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" slot="head" />
  <noscript slot="head"><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@700;800&display=swap" rel="stylesheet" /></noscript>
  <Header slot="header" current="podcast" />
  <style is:inline set:html={podcastCss}></style>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="pc-page" data-mood="day">

    <!-- HERO -->
    <section class="sec pc-hero" id="top" aria-label="WiseUp Podcast">
    <svg class="blob blob--a" viewBox="0 0 200 200" aria-hidden="true"><path fill="#beda52" d="M45.1,-58.6C57.6,-47.8,66.1,-32.4,70.4,-15.5C74.6,1.5,74.7,20,66.9,33.8C59.1,47.6,43.5,56.7,27,62.5C10.5,68.3,-6.9,70.8,-23.6,66.4C-40.4,62,-56.5,50.8,-65.4,35C-74.3,19.2,-76,-1.2,-70.1,-18.3C-64.1,-35.4,-50.5,-49.2,-35.4,-59.4C-20.3,-69.6,-3.8,-76.3,11.8,-74.6C27.3,-72.9,32.6,-69.4,45.1,-58.6Z" transform="translate(100 100)"/></svg>
      <div class="wrap pc-hero__grid">
        <div>
          <div class="pc-hero__tagrow" data-reveal="fade" data-intro>
            <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>WiseUp Podcast</p>
            <span class="pc-onair" aria-hidden="true"><i class="pc-onair__dot"></i>On air<span class="pc-eq"><i></i><i></i><i></i><i></i><i></i></span></span>
          </div>
          <h1 data-split="lines" data-intro data-delay="0.1">The Malayalam Podcast for <em>Online Business Owners</em>.</h1>
          <p class="pc-hero__ml pc-ml" lang="ml" data-reveal="up" data-intro data-delay="0.2">ഓൺലൈൻ ബിസിനസ്സ് വളർത്താൻ, ഇനി കാര്യങ്ങൾ കുറച്ചുകൂടി എളുപ്പം.</p>
          <div class="pc-hero__row" data-reveal="up" data-intro data-delay="0.3">
            <Button href={`https://www.youtube.com/watch?v=${featured.videoId}`} label="Watch Latest Episode" look="teal" external />
            <Button href={CHANNEL} label="Subscribe on YouTube" external />
          </div>
          <div class="pc-hero__proof" data-reveal="up" data-intro data-delay="0.4">
            <div class="pc-faces">{hosts.map((h) => <img src={h.img} alt="" width="36" height="36" />)}</div>
            <div><b><span data-count="91">91</span>K+</b>YouTube Subscribers</div>
          </div>
        </div>
        <div class="pc-hero__media" data-reveal="up" data-delay="0.2">
          <div class="pc-hero__img">
          <img src="/podcast/hero-team.webp" srcset="/podcast/hero-team-sm.webp 900w, /podcast/hero-team.webp 1400w" sizes="(min-width: 900px) 50vw, 100vw" alt="The WiseUp Podcast team holding their award" width="1400" height="916" loading="eager" fetchpriority="high" />
        </div>
          <!-- animated podcast stickers on the photo's corners: studio mic with sound waves, headphones -->
          <span class="pc-stk pc-stk--mic" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <g class="pc-stk__waves" fill="none" stroke="#11150a" stroke-width="3.2" stroke-linecap="round">
                <path class="w1" d="M30 42a26 26 0 0 0 0 30"/><path class="w2" d="M20 34a38 38 0 0 0 0 46"/>
                <path class="w1" d="M90 42a26 26 0 0 1 0 30"/><path class="w2" d="M100 34a38 38 0 0 1 0 46"/>
              </g>
              <g class="pc-stk__mic">
                <rect x="47" y="22" width="26" height="46" rx="13" fill="#11150a"/>
                <path d="M51 34h18M51 41h18M51 48h18" stroke="#beda52" stroke-width="2.4" stroke-linecap="round"/>
                <path d="M39 55a21 21 0 0 0 42 0" fill="none" stroke="#11150a" stroke-width="4" stroke-linecap="round"/>
                <path d="M60 76v12M48 92h24" stroke="#11150a" stroke-width="4" stroke-linecap="round"/>
              </g>
            </svg>
          </span>
          <span class="pc-stk pc-stk--hp" aria-hidden="true">
            <svg viewBox="0 0 80 80">
              <g class="pc-stk__hp">
                <path fill="#f00" d="M66.2 28.3c-.6-2.3-2-4.2-4.3-4.8C57.7 22.4 40 22.3 40 22.3s-17.7.1-21.9 1.2c-2.3.6-3.7 2.5-4.3 4.8-1.1 4.2-1.1 11.7-1.1 11.7s0 7.5 1.1 11.7c.6 2.3 2 4.2 4.3 4.8 4.2 1.1 21.9 1.2 21.9 1.2s17.7-.1 21.9-1.2c2.3-.6 3.7-2.5 4.3-4.8 1.1-4.2 1.1-11.7 1.1-11.7s0-7.5-1.1-11.7z"/>
                <path fill="#fff" d="M35 48.5 49 40l-14-8.5z"/>
              </g>
            </svg>
          </span>
        </div>
      </div>
    </section>

    <!-- FEATURED: a stack of two episode cards. Each card sticks below the header; scrolling slides the next one up
         over it while the one underneath shrinks back and dims (featuredStack(), motion/podcast.ts). -->
    <section class="sec" id="featured" aria-label="Featured episodes">
      <div class="wrap">
        <ul class="pc-fstack" data-fstack>
          {featuredList.map((f, i) => (
            <li class="pc-fcard" data-fcard>
              <a class="pc-feat__frame" data-embed data-video-id={f.videoId} href={`https://www.youtube.com/watch?v=${f.videoId}`} target="_blank" rel="noopener">
                <img src={f.img} alt={`${f.guest} on the WiseUp Podcast: ${f.title}`} width="800" height="450" loading={i === 0 ? 'eager' : 'lazy'} />
                <span class="pc-feat__play yt" set:html={ytPlay} />
              </a>
              <div class="pc-fcard__body">
                <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>{f.tag}</p>
                {f.titleMl && <p class="pc-ml pc-feat__ml" lang="ml">{f.titleMl}</p>}
                <h2 class="pc-feat__title" id={i === 0 ? 'featured-h' : undefined}>{f.title}</h2>
                <p class="pc-feat__guest">{f.guest} · {f.guestRole}</p>
                <p class="pc-feat__sub">{f.sub}</p>
                <div class="pc-feat__row">
                  <Button href={`https://www.youtube.com/watch?v=${f.videoId}`} label="Play Episode" look="teal" external />
                  <Button href="#episodes" label="More Episodes" />
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- EPISODES: a bento grid on the homepage's .card surface. The newest episode leads (2x2 on desktop), the rest
         fill the grid; every card lifts and fills brand lime on hover (same language as the homepage's list rows). The
         thumbnail is the click-to-embed link (motion/podcast.ts swaps it for the player in place); the title links out.
         Below 700px the grid becomes a swipe row. -->
    <section class="sec pc-eps" id="episodes" aria-labelledby="episodes-h">
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Latest episodes" id="episodes-h" lines={['Fresh stories,', 'every week.']} />
          <div class="pc-eps__aside" data-reveal="fade">
            <p class="pc-side">New conversations, fresh perspectives, real insights. {latest.length} recent episodes, all free on YouTube.</p>
            <Button href={CHANNEL} label="View All Episodes" icon="arrow-ur" external />
          </div>
        </div>
        <ul class="pc-eps__grid" data-eps-grid>
          {latest.map((ep, i) => (
            <li class="pc-ep" data-ep>
              <a class="pc-ep__th" data-embed data-video-id={ep.videoId} href={`https://www.youtube.com/watch?v=${ep.videoId}`} target="_blank" rel="noopener" aria-label={`Play: ${ep.title}`}>
                <img src={ep.img} srcset={`${ep.img.replace('.webp', '-sm.webp')} 360w, ${ep.img} 640w`} sizes="(min-width: 1000px) 30vw, (min-width: 700px) 45vw, 82vw" alt={ep.title} width="640" height="360" loading={i < 3 ? 'eager' : 'lazy'} />
                <span class="pc-ep__play yt" set:html={ytPlay} />
                {i === 0 && <span class="pc-ep__new"><i></i>Latest</span>}
                <span class="pc-ep__meta">{views(ep.views)} · {ago(ep.date)}</span>
              </a>
              <div class="pc-ep__body">
                {ep.tag && <span class="pc-ep__tag">{ep.tag}</span>}
                <h3><a href={`https://www.youtube.com/watch?v=${ep.videoId}`} target="_blank" rel="noopener">{ep.title}</a></h3>
                <span class="pc-ep__go" aria-hidden="true">Watch episode<i><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17 17 7M8.5 7H17v8.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></i></span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CHANNEL BANNER: the YouTube channel art, shown whole (a tighter crop on phones), linking to the subscribe prompt -->
    <section class="sec pc-band" aria-label="Subscribe to the WiseUp Podcast on YouTube">
      <div class="wrap">
        <a class="pc-band__link" href={`${CHANNEL}?sub_confirmation=1`} target="_blank" rel="noopener" data-reveal="up">
          <picture>
            <source media="(max-width: 699px)" srcset="/podcast/channel-banner-sm.webp" width="1050" height="282" />
            <img src="/podcast/channel-banner.webp" alt="Top ranked Malayalam business podcast: weekly episodes. Subscribe and enable notifications." width="1707" height="282" loading="lazy" />
          </picture>
        </a>
      </div>
    </section>

    <!-- TOPICS -->
    <section class="sec" id="topics" aria-labelledby="topics-h">
      <div class="wrap">
        <SecHead eyebrow="Explore topics" id="topics-h" lines={['Conversations across', 'what matters.']} />
        <ul class="pc-topics">
          {topics.map((t) => (
            <li data-reveal="up">
              <a class="pc-topic" href={CHANNEL} target="_blank" rel="noopener">
                <span class="pc-topic__ico" aria-hidden="true"><Icon name={t.icon} size={22} /></span>
                <h3>{t.label}</h3>
                <p>{t.desc}</p>
                <span class="pc-topic__go" aria-hidden="true"><Icon name="arrow-ur" size={18} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- COMMUNITY BANNER: live HTML over the studio photo (public/podcast/community-bg*.webp). Left: heading with the
         subscriber count, line, face stack + subscribe pill; right: four stats. Phones get a tighter crop and stack. -->
    <section class="sec" aria-labelledby="comm-h">
      <div class="wrap">
        <div class="pc-cb" data-reveal="up">
          <picture class="pc-cb__bg" aria-hidden="true">
            <source media="(max-width: 699px)" srcset="/podcast/community-bg-m.webp" />
            <img src="/podcast/community-bg.webp" srcset="/podcast/community-bg-sm.webp 900w, /podcast/community-bg.webp 2000w" sizes="(min-width: 700px) 95vw, 100vw" alt="" width="2000" height="667" loading="lazy" />
          </picture>
          <div class="pc-cb__main">
            <h2 class="pc-cb__h" id="comm-h">Join a Growing<br />Community of<br /><span class="pc-cb__big"><span data-count="91">91</span>K+</span> Curious Minds</h2>
            <p class="pc-cb__p">Watch. Learn. Grow. Be part of the conversation.</p>
            <div class="pc-cb__row">
              <div class="pc-cb__faces" aria-hidden="true">
                {[...hosts.map((h) => h.img), '/podcast/quote-jijo.webp'].map((src) => <img src={src} alt="" width="48" height="48" loading="lazy" />)}
              </div>
              <a class="pc-cb__sub" href={`${CHANNEL}?sub_confirmation=1`} target="_blank" rel="noopener">
                <svg class="pc-cb__yt" viewBox="0 0 68 48" aria-hidden="true"><path fill="#f00" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path fill="#fff" d="M45 24 27 14v20z"/></svg>
                <span>Subscribe on YouTube</span>
                <svg class="pc-cb__arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <ul class="pc-cb__stats">
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M15.5 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/></svg>100+ Episodes</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M10 8.5v7l6-3.5z" fill="currentColor" stroke="none"/></svg>91K+ Subscribers</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><circle cx="8" cy="12" r=".9" fill="currentColor"/><circle cx="12" cy="12" r=".9" fill="currentColor"/><circle cx="16" cy="12" r=".9" fill="currentColor"/></svg>Real Stories</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><circle cx="8.5" cy="14" r=".9" fill="currentColor"/><circle cx="12" cy="14" r=".9" fill="currentColor"/><circle cx="15.5" cy="14" r=".9" fill="currentColor"/><circle cx="8.5" cy="17.2" r=".9" fill="currentColor"/><circle cx="12" cy="17.2" r=".9" fill="currentColor"/></svg>Weekly Content</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- HOSTS: the three hosts in one fixed row (a swipe row on phones), lime rim on hover. -->
    <section class="sec" id="hosts" aria-labelledby="hosts-h">
    <svg class="blob blob--a" viewBox="0 0 200 200" aria-hidden="true"><path fill="#beda52" d="M45.1,-58.6C57.6,-47.8,66.1,-32.4,70.4,-15.5C74.6,1.5,74.7,20,66.9,33.8C59.1,47.6,43.5,56.7,27,62.5C10.5,68.3,-6.9,70.8,-23.6,66.4C-40.4,62,-56.5,50.8,-65.4,35C-74.3,19.2,-76,-1.2,-70.1,-18.3C-64.1,-35.4,-50.5,-49.2,-35.4,-59.4C-20.3,-69.6,-3.8,-76.3,11.8,-74.6C27.3,-72.9,32.6,-69.4,45.1,-58.6Z" transform="translate(100 100)"/></svg>
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Our hosts" id="hosts-h" lines={['The voices', 'behind WiseUp.']} />
          <p class="pc-side" data-reveal="fade">Conversations led by creators, entrepreneurs and curious minds who believe in the power of real stories.</p>
        </div>
        <ul class="pc-hosts">
            {hosts.map((p, i) => (
              <li class="pc-person" data-reveal="up" data-delay={String(i * 0.08)}>
                <figure class="pc-person__card">
                  <img src={p.img} alt={`${p.name}, host of the WiseUp Podcast`} width="400" height="500" loading="lazy" />
                  <figcaption class="pc-person__cap">
                    <span class="pc-person__name">{p.name}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
        </ul>
      </div>
    </section>

    <!-- GALLERY: bento grid of real podcast photos; a click opens the lightbox (motion/podcast.ts). -->
    <section class="sec" id="gallery" aria-labelledby="gallery-h">
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Gallery" id="gallery-h" lines={['Behind the', 'microphone.']} />
          <p class="pc-side" data-reveal="fade">Moments from the studio, the sets and the people who make every episode happen.</p>
        </div>
        <ul class="pc-gal" data-gallery>
          {gallery.map((g, i) => (
            <li class:list={['pc-gal__item', g.span && `pc-gal__item--${g.span}`]} data-reveal="up" data-delay={String((i % 4) * 0.06)}>
              <button class="pc-gal__btn" type="button" data-gal-open={i} data-src={g.img} data-cap={g.cap} aria-label={`Open photo: ${g.cap}`}>
                <img src={g.sm} srcset={`${g.sm} 800w, ${g.img} 1600w`} sizes={g.span === 'big' ? '(min-width: 700px) 50vw, 100vw' : g.span ? '(min-width: 700px) 50vw, 100vw' : '(min-width: 700px) 25vw, 50vw'} alt={g.alt} width={g.w} height={g.h} loading="lazy" />
                <span class="pc-gal__cap">{g.cap}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <dialog class="pc-lb" data-lightbox aria-label="Photo viewer">
        <figure class="pc-lb__fig">
          <img data-lb-img alt="" />
          <figcaption data-lb-cap></figcaption>
        </figure>
        <button class="pc-lb__btn pc-lb__close" type="button" aria-label="Close" data-lb-close><Icon name="x" size={20} /></button>
        <button class="pc-lb__btn pc-lb__prev" type="button" aria-label="Previous photo" data-lb-prev><Icon name="chev-l" size={20} /></button>
        <button class="pc-lb__btn pc-lb__next" type="button" aria-label="Next photo" data-lb-next><Icon name="chev-r" size={20} /></button>
      </dialog>
    </section>

    <!-- VIDEO TESTIMONIALS: reel-style 9:16 cards in a swipe row with prev/next. A click swaps the poster for the
         video, playing in place (motion/podcast.ts); starting one pauses any other. -->
    <section class="sec" id="testimonials" aria-labelledby="testimonials-h">
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Testimonials" id="testimonials-h" lines={['In their', 'own words.']} />
          <div class="loop-nav">
            <button class="loop-btn" type="button" aria-label="Previous videos" data-tst-prev><Icon name="chev-l" size={18} /></button>
            <button class="loop-btn" type="button" aria-label="Next videos" data-tst-next><Icon name="chev-r" size={18} /></button>
          </div>
        </div>
        <ul class="pc-tst" data-tst-track>
          {testimonials.map((t, i) => (
            <li class="pc-tst__card" data-reveal="up" data-delay={String((i % 4) * 0.06)}>
              <button class="pc-tst__media" type="button" data-tst-video={t.video} aria-label={`Play testimonial video ${i + 1} of ${testimonials.length}`}>
                <img src={`${WP}/06/${t.poster}-576x1024.webp`} srcset={`${WP}/06/${t.poster}-169x300.webp 169w, ${WP}/06/${t.poster}-576x1024.webp 576w, ${WP}/06/${t.poster}-768x1365.webp 768w`} sizes="(min-width: 900px) 25vw, 70vw" alt="" width="576" height="1024" loading="lazy" />
                <span class="pc-tst__play" aria-hidden="true"><i><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg></i>Watch story</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ: two columns. Left (sticky): heading, the studio mic photo and a contact line; right: the questions. -->
    <section class="sec" id="faq" aria-labelledby="faq-h">
      <div class="wrap pc-faq">
        <aside class="pc-faq__side">
          <SecHead eyebrow="FAQ" id="faq-h" lines={['Questions,', 'answered.']} />
          <figure class="pc-faq__art" data-reveal="up" aria-hidden="true">
            <svg viewBox="0 0 480 400">
              <path class="fa-blob" fill="#beda52" d="M250 40c70-8 150 30 172 98 22 66-12 146-78 184-64 38-160 42-222 6C62 292 34 220 52 158 70 92 168 50 250 40Z"/>
              <g class="fa-waves" fill="none" stroke="#11150a" stroke-width="6" stroke-linecap="round">
                <path d="M150 150a90 90 0 0 0 0 110"/><path d="M118 126a130 130 0 0 0 0 158" opacity=".55"/>
                <path d="M330 150a90 90 0 0 1 0 110"/><path d="M362 126a130 130 0 0 1 0 158" opacity=".55"/>
              </g>
              <g class="fa-mic">
                <rect x="196" y="92" width="88" height="150" rx="44" fill="#11150a"/>
                <path d="M210 130h60M210 152h60M210 174h60M210 196h60" stroke="#beda52" stroke-width="5" stroke-linecap="round"/>
                <path d="M172 196a68 68 0 0 0 136 0" fill="none" stroke="#11150a" stroke-width="12" stroke-linecap="round"/>
                <path d="M240 264v44M196 316h88" stroke="#11150a" stroke-width="12" stroke-linecap="round"/>
              </g>
              <g class="fa-q fa-q1"><rect x="20" y="52" width="92" height="70" rx="22" fill="#11150a"/><path d="M40 122l-4 22 22-22z" fill="#11150a"/><text x="66" y="104" text-anchor="middle" font-size="46" font-weight="700" fill="#beda52" font-family="Inter, sans-serif">?</text></g>
              <g class="fa-q fa-q2"><rect x="378" y="250" width="84" height="64" rx="20" fill="#fff" stroke="#11150a" stroke-width="4"/><path d="M440 312l6 20-22-18z" fill="#fff" stroke="#11150a" stroke-width="4" stroke-linejoin="round"/><text x="420" y="298" text-anchor="middle" font-size="40" font-weight="700" fill="#11150a" font-family="Inter, sans-serif">!</text></g>
              <g class="fa-q fa-q3"><circle cx="404" cy="78" r="26" fill="#11150a"/><text x="404" y="92" text-anchor="middle" font-size="36" font-weight="700" fill="#beda52" font-family="Inter, sans-serif">?</text></g>
            </svg>
          </figure>
          <p class="pc-faq__ask" data-reveal="up">Still curious? <a href="mailto:wiseuppod@gmail.com">wiseuppod@gmail.com</a></p>
        </aside>
        <div class="faq" data-faq>
          {faqs.map((f, i) => (
            <details class="faq__item" name="podcast-faq" data-reveal="up" data-delay={String(Math.min(i, 3) * 0.05)}>
              <summary class="faq__q"><h3>{f.q}</h3><span class="faq__dot" aria-hidden="true"></span></summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- GUEST PITCH: the homepage's contact pattern (SecHead + lime-hover .cta-row links) beside the banner -->
    <section class="sec" id="guest" aria-labelledby="guest-h">
    <svg class="blob blob--c" viewBox="0 0 200 200" aria-hidden="true"><path fill="#beda52" d="M45.1,-58.6C57.6,-47.8,66.1,-32.4,70.4,-15.5C74.6,1.5,74.7,20,66.9,33.8C59.1,47.6,43.5,56.7,27,62.5C10.5,68.3,-6.9,70.8,-23.6,66.4C-40.4,62,-56.5,50.8,-65.4,35C-74.3,19.2,-76,-1.2,-70.1,-18.3C-64.1,-35.4,-50.5,-49.2,-35.4,-59.4C-20.3,-69.6,-3.8,-76.3,11.8,-74.6C27.3,-72.9,32.6,-69.4,45.1,-58.6Z" transform="translate(100 100)"/></svg>
      <div class="wrap pc-pitch">
        <div>
          <SecHead eyebrow="Be a guest" id="guest-h" lines={['Have a story', 'worth sharing?']} />
          <p class="pc-pitch__p" data-reveal="up">We're always excited to talk with entrepreneurs, creators, experts and interesting people from diverse fields. Share your journey, inspire others, and be part of the WiseUp conversation.</p>
        </div>
        <div>
          <ul class="cta-rows pc-pitch__rows" data-reveal="up">
            <li>
              <a class="cta-row" href={site.whatsapp} rel="noopener" target="_blank">
                <Icon name="whatsapp" size={22} class="cta-row__ico" />
                <span class="cta-row__body"><span class="cta-row__t">Apply on WhatsApp</span><span class="cta-row__v">{site.phone}</span></span>
                <Icon name="arrow-ur" size={18} class="cta-row__go" />
              </a>
            </li>
            <li>
              <a class="cta-row" href="mailto:wiseuppod@gmail.com">
                <Icon name="mail" size={22} class="cta-row__ico" />
                <span class="cta-row__body"><span class="cta-row__t">Email the podcast team</span><span class="cta-row__v">wiseuppod@gmail.com</span></span>
                <Icon name="arrow-ur" size={18} class="cta-row__go" />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

  </div>

</Base>
