---
// WiseUp Podcast, rebuilt on the homepage's own design system (2026-10-23), per direct owner
// instruction: "use our homepage design system to rebuild the podcast page... same as homepage
// (default light version)". Supersedes the standalone warm-paper/gold page this was before —
// now Base + Header + Footer, tokens.css's teal/lime accent and Epilogue/Inter type, and the
// shared site.css vocabulary (.wrap/.sec/.sh/.b/.card/.faq/.hgal/.loop/.cta-row), forced to the
// light ("day") mood throughout via `data-mood="day"` on the page's own wrapper, same technique
// about.astro uses. Motion: episodes are a static bento grid (lime hover); the three hosts sit in a fixed row; the shared
// engine's own loopedPanels() (motion/main.ts) via the same data attributes
// the homepage uses — not reimplemented. Only the click-to-embed thumbnail behaviour is page-
// specific (motion/podcast.ts, registered into the shared setupMotion()).
//
// Content carried over unchanged from the prior standalone build: all real video IDs (oembed-
// confirmed), real host/guest photos, the real "91K+"/"100+" stats, all 15 FAQ entries, the real
// community banner and guest-CTA banner images. See CLAUDE.md for the full sourcing history
// (which topic-card photos are real vs. placeholder stock, the Deepu/guest-photo gaps, etc.).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SecHead from '../components/SecHead.astro';
import { site } from '../data/site';
import podcastCss from '../styles/podcast.css?raw';

const CHANNEL = 'https://www.youtube.com/@WiseUpPodcast_';
// YouTube's play button (red rounded rect + white triangle), shown over every video thumbnail
const ytPlay = '<svg viewBox="0 0 68 48" aria-hidden="true"><path class="yt__bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path fill="#fff" d="M45 24 27 14v20z"/></svg>';

const featured = {
  videoId: 'h9kHyyUruSg',
  img: '/podcast/yt-featured.webp',
  guest: 'Jijo Sunny',
  guestRole: 'Co-founder & CEO, Buy Me a Coffee',
  title: 'Lakhs Flow Through Coffee, But It Is Not a Coffee Shop',
  titleMl: 'കാപ്പി വഴി ലക്ഷങ്ങൾ, പക്ഷെ കാപ്പിക്കടയല്ല',
  sub: 'A ₹400 crore Malayali startup, built around the idea of "buy me a coffee." Jijo Sunny on turning a small tip jar into a global platform.',
};

const episodes = [
  { videoId: 'ejaRfh4zpzY', img: '/podcast/yt-bootland2.webp', title: 'How to Grow a Retail Business in India', tag: 'Bootland Footwear & Lifestyle Expo' },
  { videoId: 'kanbmwUHio0', img: '/podcast/yt-abcgroup.webp', title: 'From One Room to 9 Countries: 100+ Companies, 4000+ Employees', tag: 'ABC Group' },
  { videoId: 'jgVrZalE6io', img: '/podcast/yt-eduflair.webp', title: "Kozhikode's Largest Language Campus?", tag: 'Eduflair Podcast · Adv. K.M. Roy' },
  { videoId: 'h9kHyyUruSg', img: '/podcast/yt-featured.webp', title: 'Lakhs Flow Through Coffee, But It Is Not a Coffee Shop', tag: 'Jijo Sunny · Buy Me a Coffee' },
  { videoId: 'CrUDF-dJHXI', img: '/podcast/yt-litmus7.webp', title: 'How Litmus7 CEO Shapes the Future of Retail & Tech', tag: 'Venu Gopalakrishnan · Litmus7' },
  { videoId: 'qXbPA48XcOs', img: '/podcast/yt-mend.webp', title: 'Can You Build a Fashion Business in Kerala? Mend Did.', tag: 'Mend' },
  { videoId: 'hpVHpprI6s0', img: '/podcast/yt-trs.webp', title: "The Producer's Formula: Success in Film and Education", tag: 'T. R. Shamsudeen' },
  { videoId: 'nccuN47XdbM', img: '/podcast/yt-sajeevnair.webp', title: "If You Haven't Achieved Success Yet, This Might Be Why", tag: 'Sajeev Nair' },
  { videoId: '26T1GMmQFng', img: '/podcast/yt-johnkuriakose.webp', title: "From ₹250 Salary to Asia's Largest Dental Lab", tag: 'John Kuriakose' },
];

// Cover photos: real CC-licensed photography (Wikimedia Commons), standing in for brand
// photography WiseUp hasn't supplied yet for these 5 categories — see CLAUDE.md.
const topics = [
  { n: '01', label: 'Business & Entrepreneurship', icon: 'target', img: '/podcast/topic-business.webp' },
  { n: '02', label: 'Marketing & Branding', icon: 'megaphone', img: '/podcast/topic-marketing.webp' },
  { n: '03', label: 'Technology & AI', icon: 'code', img: '/podcast/topic-tech.webp' },
  { n: '04', label: 'Leadership & Career', icon: 'sprout', img: '/podcast/topic-leadership.webp' },
  { n: '05', label: 'Creators & Media', icon: 'video', img: '/podcast/topic-creators.webp' },
];

const hosts = [
  { name: 'Jijin Mohan', role: 'Host', img: '/podcast/host-jijin.webp' },
  { name: 'Chethana', role: 'Host', img: '/podcast/host-chethana.webp' },
  { name: 'Sreerag', role: 'Host', img: '/podcast/host-sreerag.webp' },
];

// Gallery: real WiseUp Podcast photos only. Add more by appending { img, w, h, alt, cap, span } (span: 'big' 2x2, 'tall' 1x2,
// 'wide' 2x1, or none for 1x1).
const gallery = [
  { img: '/podcast/hero-team.webp', w: 1400, h: 916, alt: 'The WiseUp Podcast team holding their award', cap: 'Top ranked Malayalam business podcast', span: 'big' },
  { img: '/podcast/quote-jijo.webp', w: 700, h: 795, alt: 'Jijo Sunny in the WiseUp Podcast studio', cap: 'Jijo Sunny, Buy Me a Coffee', span: 'tall' },
  { img: '/podcast/host-jijin.webp', w: 400, h: 500, alt: 'Jijin Mohan, host of the WiseUp Podcast', cap: 'Jijin Mohan, host', span: 'tall' },
  { img: '/podcast/host-chethana.webp', w: 400, h: 500, alt: 'Chethana, host of the WiseUp Podcast', cap: 'Chethana, host', span: 'tall' },
  { img: '/podcast/yt-featured.webp', w: 640, h: 360, alt: 'On set with Jijo Sunny', cap: 'On set: Buy Me a Coffee', span: 'wide' },
  { img: '/podcast/host-sreerag.webp', w: 400, h: 500, alt: 'Sreerag, host of the WiseUp Podcast', cap: 'Sreerag, host', span: 'tall' },
  { img: '/podcast/yt-abcgroup.webp', w: 640, h: 360, alt: 'On set with ABC Group', cap: 'On set: ABC Group' },
  { img: '/podcast/yt-litmus7.webp', w: 640, h: 360, alt: 'On set with Venu Gopalakrishnan of Litmus7', cap: 'On set: Litmus7' },
];

const faqs = [
  { q: 'What is WiseUp Podcast?', a: "It's a business and entrepreneurship podcast featuring founders, business leaders, marketers, investors and industry experts." },
  { q: 'Who can be a guest on the podcast?', a: 'Founders, CEOs, business owners, industry experts, investors, creators and professionals with valuable insights or stories to share.' },
  { q: 'How can I apply to be a guest?', a: 'Submit your details through the inquiry form or contact the team directly. Guests are selected based on relevance and audience value.' },
  { q: 'Is there a fee to appear on the podcast?', a: 'Participation may be free or part of a promotional collaboration. The team can share the details.' },
  { q: 'How long is a typical podcast episode?', a: 'Most episodes run between 30 and 90 minutes.' },
  { q: 'Where are the episodes published?', a: 'On YouTube, Spotify, Instagram, Facebook and other WiseUp platforms.' },
  { q: 'Can brands sponsor an episode?', a: 'Yes. Brands can sponsor a single episode or take a monthly partnership package.' },
  { q: 'What sponsorship opportunities are available?', a: 'Episode sponsorship, product placement, host mentions, thumbnail branding, intro/outro branding, reels and shorts branding, social media promotions and long-term partnerships.' },
  { q: 'What audience does the podcast reach?', a: 'Entrepreneurs, startup founders, business owners, professionals, marketers, students and aspiring leaders.' },
  { q: 'Will I receive the podcast recording?', a: 'Yes. Guests receive the published episode link and selected promotional assets.' },
  { q: 'Can you record podcasts at our office or location?', a: 'Yes. Both studio and on-location recordings are offered.' },
  { q: 'How far in advance should I book?', a: 'Book at least 2 to 4 weeks ahead.' },
  { q: 'Do you provide podcast production services?', a: 'Yes, including recording, multi-camera setup, thumbnails, reels and shorts, publishing support and podcast marketing.' },
  { q: 'How do I become a sponsor?', a: 'Contact the team with your brand details and campaign goals to get a recommended package.' },
  { q: 'How can I contact the WiseUp Podcast team?', a: 'By phone, email (wiseuppod@gmail.com), WhatsApp (+91 6282 434 503) or the website contact form. The team responds within 24 to 48 hours.' },
];

const title = 'WiseUp Podcast | The Malayalam Podcast for Online Business Owners';
const description = 'A Malayalam business podcast with entrepreneurs, creators and changemakers who are building a better tomorrow.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'PodcastSeries', name: 'WiseUp Podcast', description,
  url: 'https://wiseup.in/podcast', image: 'https://wiseup.in/podcast/banner.jpg', inLanguage: 'ml', sameAs: [CHANNEL],
};
---
<Base title={title} description={description} image="/podcast/banner.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <!-- Non-blocking: the Malayalam font swaps in once loaded (FOUC-safe, Inter already covers
       Latin text in the interim) rather than holding up first paint — a render-blocking
       <link rel="stylesheet"> here measurably delayed the hero text's paint on throttled mobile. -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" slot="head" />
  <noscript slot="head"><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@700;800&display=swap" rel="stylesheet" /></noscript>
  <Header slot="header" current="podcast" />
  <style is:inline set:html={podcastCss}></style>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="pc-page" data-mood="day">

    <!-- HERO -->
    <section class="sec pc-hero" id="top" aria-label="WiseUp Podcast">
    <svg class="blob blob--a" viewBox="0 0 200 200" aria-hidden="true"><path fill="#beda52" d="M45.1,-58.6C57.6,-47.8,66.1,-32.4,70.4,-15.5C74.6,1.5,74.7,20,66.9,33.8C59.1,47.6,43.5,56.7,27,62.5C10.5,68.3,-6.9,70.8,-23.6,66.4C-40.4,62,-56.5,50.8,-65.4,35C-74.3,19.2,-76,-1.2,-70.1,-18.3C-64.1,-35.4,-50.5,-49.2,-35.4,-59.4C-20.3,-69.6,-3.8,-76.3,11.8,-74.6C27.3,-72.9,32.6,-69.4,45.1,-58.6Z" transform="translate(100 100)"/></svg>
      <div class="wrap pc-hero__grid">
        <div>
          <p class="eyebrow" data-reveal="fade" data-intro><span class="eyebrow__dot" aria-hidden="true"></span>WiseUp Podcast</p>
          <h1 data-split="lines" data-intro data-delay="0.1">The Malayalam Podcast for <em>Online Business Owners</em>.</h1>
          <p class="pc-hero__ml pc-ml" lang="ml" data-reveal="up" data-intro data-delay="0.2">ഓൺലൈൻ ബിസിനസ്സ് വളർത്താൻ, ഇനി കാര്യങ്ങൾ കുറച്ചുകൂടി എളുപ്പം.</p>
          <div class="pc-hero__row" data-reveal="up" data-intro data-delay="0.3">
            <Button href={`https://www.youtube.com/watch?v=${featured.videoId}`} label="Watch Latest Episode" look="teal" external />
            <Button href={CHANNEL} label="Subscribe on YouTube" external />
          </div>
          <div class="pc-hero__proof" data-reveal="up" data-intro data-delay="0.4">
            <div class="pc-faces">{hosts.map((h) => <img src={h.img} alt="" width="36" height="36" />)}</div>
            <div><b><span data-count="91">91</span>K+</b>YouTube Subscribers</div>
          </div>
        </div>
        <div class="pc-hero__img" data-reveal="up" data-delay="0.2">
          <img src="/podcast/hero-team.webp" srcset="/podcast/hero-team-sm.webp 900w, /podcast/hero-team.webp 1400w" sizes="(min-width: 900px) 50vw, 100vw" alt="The WiseUp Podcast team holding their award" width="1400" height="916" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- FEATURED EPISODE -->
    <section class="sec" id="featured" aria-labelledby="featured-h">
      <div class="wrap pc-feat">
        <a class="pc-feat__frame" data-embed data-video-id={featured.videoId} href={`https://www.youtube.com/watch?v=${featured.videoId}`} target="_blank" rel="noopener" data-reveal="up">
          <img src={featured.img} alt={`${featured.guest} on the WiseUp Podcast: ${featured.title}`} width="800" height="500" loading="eager" />
          <span class="pc-feat__play yt" set:html={ytPlay} />
        </a>
        <div data-reveal="up">
          <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Featured episode</p>
          <p class="pc-ml pc-feat__ml" lang="ml">{featured.titleMl}</p>
          <h2 class="pc-feat__title" id="featured-h">{featured.title}</h2>
          <p class="pc-feat__guest">{featured.guest} · {featured.guestRole}</p>
          <p class="pc-feat__sub">{featured.sub}</p>
          <div class="pc-feat__row">
            <Button href={`https://www.youtube.com/watch?v=${featured.videoId}`} label="Play Episode" look="teal" external />
            <Button href="#episodes" label="More Episodes" />
          </div>
        </div>
      </div>
    </section>

    <!-- EPISODES: a bento grid on the homepage's .card surface. The newest episode leads (2x2 on desktop), the rest
         fill the grid; every card lifts and fills brand lime on hover (same language as the homepage's list rows). The
         thumbnail is the click-to-embed link (motion/podcast.ts swaps it for the player in place); the title links out.
         Below 700px the grid becomes a swipe row. -->
    <section class="sec pc-eps" id="episodes" aria-labelledby="episodes-h">
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Latest episodes" id="episodes-h" lines={['Fresh stories,', 'every week.']} />
          <div class="pc-eps__aside" data-reveal="fade">
            <p class="pc-side">New conversations, fresh perspectives, real insights. {episodes.length} recent episodes, all free on YouTube.</p>
            <Button href={CHANNEL} label="View All Episodes" icon="arrow-ur" external />
          </div>
        </div>
        <ul class="pc-eps__grid">
          {episodes.map((ep, i) => (
            <li class:list={['pc-ep card', { 'pc-ep--lead': i === 0 }]} data-reveal="up" data-delay={String((i % 3) * 0.06)}>
              <a class="pc-ep__th" data-embed data-video-id={ep.videoId} href={`https://www.youtube.com/watch?v=${ep.videoId}`} target="_blank" rel="noopener" aria-label={`Play: ${ep.title}`}>
                <img src={ep.img} srcset={`${ep.img.replace('.webp', '-sm.webp')} 360w, ${ep.img} 640w`} sizes={i === 0 ? '(min-width: 1000px) 60vw, 90vw' : '(min-width: 1000px) 30vw, 80vw'} alt={ep.title} width="640" height="360" loading={i < 3 ? 'eager' : 'lazy'} />
                <span class="pc-ep__play yt" set:html={ytPlay} />
                {i === 0 && <span class="pc-ep__new">New episode</span>}
              </a>
              <div class="pc-ep__body">
                <span class="pc-ep__tag">{ep.tag}</span>
                <h3><a href={`https://www.youtube.com/watch?v=${ep.videoId}`} target="_blank" rel="noopener">{ep.title}</a></h3>
                <span class="pc-ep__go" aria-hidden="true">Watch on YouTube<Icon name="arrow-ur" size={16} /></span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CHANNEL BANNER: the YouTube channel art, shown whole (a tighter crop on phones), linking to the subscribe prompt -->
    <section class="sec pc-band" aria-label="Subscribe to the WiseUp Podcast on YouTube">
      <div class="wrap">
        <a class="pc-band__link" href={`${CHANNEL}?sub_confirmation=1`} target="_blank" rel="noopener" data-reveal="up">
          <picture>
            <source media="(max-width: 699px)" srcset="/podcast/channel-banner-sm.webp" width="1050" height="282" />
            <img src="/podcast/channel-banner.webp" alt="Top ranked Malayalam business podcast: weekly episodes. Subscribe and enable notifications." width="1707" height="282" loading="lazy" />
          </picture>
        </a>
      </div>
    </section>

    <!-- TOPICS -->
    <section class="sec" id="topics" aria-labelledby="topics-h">
      <div class="wrap">
        <SecHead eyebrow="Explore topics" id="topics-h" lines={['Conversations across', 'what matters.']} />
        <div class="pc-topics">
          {topics.map((t) => (
            <a class="pc-topic card" href={CHANNEL} target="_blank" rel="noopener" data-reveal="up">
              <img class="pc-topic__bg" src={t.img} srcset={`${t.img.replace('.webp', '-sm.webp')} 340w, ${t.img} 600w`} sizes="(min-width: 900px) 240px, 45vw" alt="" width="600" height="760" loading="lazy" />
              <span class="pc-topic__scrim" aria-hidden="true"></span>
              <span class="pc-topic__ico"><Icon name={t.icon} size={18} /></span>
              <span class="pc-topic__n">{t.n}</span>
              <h3>{t.label}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- COMMUNITY BANNER -->
    <section class="sec" aria-label="Join the WiseUp Podcast community">
      <div class="wrap">
        <div data-reveal="up">
          <a href={CHANNEL} target="_blank" rel="noopener" class="card pc-comm-banner">
            <img src="/podcast/community-banner.webp" alt="Join a growing community of 91K+ curious minds. Watch, learn, grow, be part of the conversation. 100+ episodes, 91K+ subscribers, real stories, weekly content." width="2000" height="667" loading="lazy" />
          </a>
        </div>
      </div>
    </section>

    <!-- HOSTS: the three hosts in one fixed row (a swipe row on phones), lime rim on hover. -->
    <section class="sec" id="hosts" aria-labelledby="hosts-h">
    <svg class="blob blob--a" viewBox="0 0 200 200" aria-hidden="true"><path fill="#beda52" d="M45.1,-58.6C57.6,-47.8,66.1,-32.4,70.4,-15.5C74.6,1.5,74.7,20,66.9,33.8C59.1,47.6,43.5,56.7,27,62.5C10.5,68.3,-6.9,70.8,-23.6,66.4C-40.4,62,-56.5,50.8,-65.4,35C-74.3,19.2,-76,-1.2,-70.1,-18.3C-64.1,-35.4,-50.5,-49.2,-35.4,-59.4C-20.3,-69.6,-3.8,-76.3,11.8,-74.6C27.3,-72.9,32.6,-69.4,45.1,-58.6Z" transform="translate(100 100)"/></svg>
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Our hosts" id="hosts-h" lines={['The voices', 'behind WiseUp.']} />
          <p class="pc-side" data-reveal="fade">Conversations led by creators, entrepreneurs and curious minds who believe in the power of real stories.</p>
        </div>
        <ul class="pc-hosts">
            {hosts.map((p, i) => (
              <li class="pc-person" data-reveal="up" data-delay={String(i * 0.08)}>
                <figure class="pc-person__card">
                  <img src={p.img} alt={`${p.name}, host of the WiseUp Podcast`} width="400" height="500" loading="lazy" />
                  <figcaption class="pc-person__cap">
                    <span class="pc-person__name">{p.name}</span>
                    <span class="pc-person__role">Host, WiseUp Podcast</span>
                  </figcaption>
                </figure>
              </li>
            ))}
        </ul>
      </div>
    </section>

    <!-- GALLERY: bento grid of real podcast photos; a click opens the lightbox (motion/podcast.ts). -->
    <section class="sec" id="gallery" aria-labelledby="gallery-h">
      <div class="wrap">
        <div class="loop-head">
          <SecHead eyebrow="Gallery" id="gallery-h" lines={['Behind the', 'microphone.']} />
          <p class="pc-side" data-reveal="fade">Moments from the studio, the sets and the people who make every episode happen.</p>
        </div>
        <ul class="pc-gal" data-gallery>
          {gallery.map((g, i) => (
            <li class:list={['pc-gal__item', g.span && `pc-gal__item--${g.span}`]} data-reveal="up" data-delay={String((i % 4) * 0.06)}>
              <button class="pc-gal__btn" type="button" data-gal-open={i} data-src={g.img} data-cap={g.cap} aria-label={`Open photo: ${g.cap}`}>
                <img src={g.img} alt={g.alt} width={g.w} height={g.h} loading="lazy" />
                <span class="pc-gal__cap">{g.cap}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <dialog class="pc-lb" data-lightbox aria-label="Photo viewer">
        <figure class="pc-lb__fig">
          <img data-lb-img alt="" />
          <figcaption data-lb-cap></figcaption>
        </figure>
        <button class="pc-lb__btn pc-lb__close" type="button" aria-label="Close" data-lb-close><Icon name="x" size={20} /></button>
        <button class="pc-lb__btn pc-lb__prev" type="button" aria-label="Previous photo" data-lb-prev><Icon name="chev-l" size={20} /></button>
        <button class="pc-lb__btn pc-lb__next" type="button" aria-label="Next photo" data-lb-next><Icon name="chev-r" size={20} /></button>
      </dialog>
    </section>

    <!-- FAQ: exact homepage pattern -->
    <section class="sec" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <SecHead eyebrow="FAQ" id="faq-h" lines={['Questions,', 'answered.']} />
        <div class="faq" data-faq>
          {faqs.map((f, i) => (
            <details class="faq__item" name="podcast-faq" data-reveal="up" data-delay={String(Math.min(i, 3) * 0.05)}>
              <summary class="faq__q"><h3>{f.q}</h3><span class="faq__dot" aria-hidden="true"></span></summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- GUEST PITCH: the homepage's contact pattern (SecHead + lime-hover .cta-row links) beside the banner -->
    <section class="sec" id="guest" aria-labelledby="guest-h">
    <svg class="blob blob--c" viewBox="0 0 200 200" aria-hidden="true"><path fill="#beda52" d="M45.1,-58.6C57.6,-47.8,66.1,-32.4,70.4,-15.5C74.6,1.5,74.7,20,66.9,33.8C59.1,47.6,43.5,56.7,27,62.5C10.5,68.3,-6.9,70.8,-23.6,66.4C-40.4,62,-56.5,50.8,-65.4,35C-74.3,19.2,-76,-1.2,-70.1,-18.3C-64.1,-35.4,-50.5,-49.2,-35.4,-59.4C-20.3,-69.6,-3.8,-76.3,11.8,-74.6C27.3,-72.9,32.6,-69.4,45.1,-58.6Z" transform="translate(100 100)"/></svg>
      <div class="wrap pc-pitch">
        <div>
          <SecHead eyebrow="Be a guest" id="guest-h" lines={['Have a story', 'worth sharing?']} />
